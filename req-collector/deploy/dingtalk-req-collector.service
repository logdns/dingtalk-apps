[Unit]
Description=Kingdee Requirement Collector (Go)
After=network.target mysql.service

[Service]
Type=simple
# 修改为实际部署路径
WorkingDirectory=/opt/dingtalk-req-collector
ExecStart=/opt/dingtalk-req-collector/dingtalk-req-collector -config /opt/dingtalk-req-collector/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
